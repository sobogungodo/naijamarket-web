model OTP_Codes {
  id          Int       @id(map: "PK__OTP_Code__3213E83F59514465") @default(autoincrement())
  identifier  String    @db.NVarChar(255)
  type        String    @db.VarChar(20)
  code        String    @db.VarChar(6)
  attempts    Int?      @default(0, map: "DF__OTP_Codes__attem__02A839AF")
  verified    Boolean?  @default(false, map: "DF__OTP_Codes__verif__039C5DE8")
  verified_at DateTime?
  expires_at  DateTime
  created_at  DateTime? @default(now(), map: "DF__OTP_Codes__creat__04908221")

  @@index([expires_at], map: "IX_OTP_Expires")
  @@index([identifier, type], map: "IX_OTP_Identifier")
}

