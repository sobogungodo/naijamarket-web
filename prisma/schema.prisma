generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE MODELS - All have primary keys and are usable by Prisma
// ============================================================================

model Consumers {
  consumer_id                String    @id @db.NVarChar(50)
  phone_number               String?   @db.NVarChar(20)
  email                      String?   @unique @db.NVarChar(255)
  password_hash              String?   @db.NVarChar(255)
  preferred_language         String?   @db.NVarChar(50)
  first_name                 String?   @db.NVarChar(50)
  last_name                  String?   @db.NVarChar(50)
  full_name                  String?   @db.NVarChar(50)
  gender                     String?   @db.NVarChar(50)
  age_range                  String?   @db.NVarChar(255)
  registration_date          DateTime? @db.Date
  registration_source        String?   @db.NVarChar(50)
  subscription_tier          String?   @db.NVarChar(50)
  subscription_start         String?   @db.NVarChar(255)
  subscription_end           String?   @db.NVarChar(255)
  grace_period_end           String?   @db.NVarChar(255)
  pending_downgrade_tier     String?   @db.NVarChar(255)
  downgrade_effective_date   DateTime? @db.Date
  auto_renew                 String?   @db.NVarChar(255)
  daily_query_limit          Int?
  daily_queries_used         Boolean?
  weekly_queries_used        Boolean?
  weekly_queries_reset       String?   @db.NVarChar(255)
  queries_today              Boolean?
  queries_this_week          Boolean?
  total_queries              Int?
  last_query_date            DateTime? @db.Date
  favorite_markets           String?   @db.NVarChar(50)
  favorite_items             String?   @db.NVarChar(255)
  max_markets                Int?
  favorite_markets_2         String?   @db.NVarChar(50)
  queries_remaining          Int?
  account_status             String?   @db.NVarChar(50)
  last_active_at             DateTime?
  created_at                 DateTime?
  updated_at                 DateTime? @updatedAt
  referred_by                String?   @db.NVarChar(255)
  referral_code              String?   @db.NVarChar(255)
  daily_abandon_count        Int?
  last_abandon_date          DateTime? @db.Date
  abandon_locked_until       String?   @db.NVarChar(255)
  registration_blocked_until String?   @db.NVarChar(255)
  notes                      String?   @db.NVarChar(255)
  date_of_birth              DateTime? @db.Date
  age                        String?   @db.NVarChar(255)
  city                       String?   @db.NVarChar(50)
  state                      String?   @db.NVarChar(50)
  max_alerts                 Boolean?
  tc_accepted                Boolean?
  tc_accepted_at             DateTime?
  tc_version                 Boolean?
  phone_verified             Boolean?  @default(false)
  email_verified             Boolean?  @default(false)
  phone                      String?   @db.VarChar(20)
  settings_json         String?   @db.NVarChar(Max)
  two_factor_enabled    Boolean   @default(false) @map("two_factor_enabled")
  two_factor_method     String?   @map("two_factor_method") @db.NVarChar(20)
  two_factor_enabled_at DateTime? @map("two_factor_enabled_at")

  @@index([phone_number])
  @@index([email])
}

model OTP_Codes {
  id          Int       @id @default(autoincrement())
  identifier  String    @db.NVarChar(255)
  type        String    @db.VarChar(20)
  code        String    @db.VarChar(6)
  attempts    Int?      @default(0)
  verified    Boolean?  @default(false)
  verified_at DateTime?
  expires_at  DateTime
  created_at  DateTime? @default(now())

  @@index([expires_at])
  @@index([identifier, type])
}

model Approved_Prices {
  price_id             String    @id @db.VarChar(50)
  submission_id        String?   @db.VarChar(50)
  state                String?   @db.NVarChar(100)
  market_name          String?   @db.NVarChar(200)
  market_id            String?   @db.VarChar(20)
  category_name        String?   @db.NVarChar(200)
  category_id          String?   @db.VarChar(20)
  item_name            String?   @db.NVarChar(300)
  item_id              String?   @db.VarChar(20)
  brand_name           String?   @db.NVarChar(200)
  brand_id             String?   @db.VarChar(20)
  price                Decimal?  @db.Decimal(18, 2)
  unit                 String?   @db.VarChar(50)
  currency             String?   @default("NGN") @db.VarChar(10)
  submission_date      DateTime? @db.DateTime
  validated_at         DateTime? @db.DateTime
  validation_status    String?   @db.VarChar(30)
  validators_count     Int?
  approval_count       Int?
  reject_count         Int?
  consensus_method     String?   @db.VarChar(50)
  trader_phone         String?   @db.VarChar(20)
  trader_id            String?   @db.VarChar(50)
  trader_name          String?   @db.NVarChar(200)
  trader_reputation    String?   @db.VarChar(30)
  gps_latitude         Decimal?  @db.Decimal(10, 7)
  gps_longitude        Decimal?  @db.Decimal(10, 7)
  gps_verified         Boolean?
  previous_price       Decimal?  @db.Decimal(18, 2)
  price_change_amount  Decimal?  @db.Decimal(18, 2)
  price_change_percent Decimal?  @db.Decimal(10, 2)
  price_trend          String?   @db.VarChar(10)
  data_source          String?   @db.VarChar(50)
  confidence_score     Int?
  is_outlier           Boolean?  @default(false)
  notes                String?   @db.NVarChar(Max)

  @@index([item_id])
  @@index([market_id])
}

model Markets {
  market_id         String    @id @db.NVarChar(50)
  region_id         String?   @db.NVarChar(50)
  market_name       String?   @db.NVarChar(50)
  state             String?   @db.NVarChar(50)
  latitude          Decimal?  @db.Decimal(9, 6)
  longitude         Decimal?  @db.Decimal(9, 6)
  radius_meters     Int?
  opening_hours     String?   @db.NVarChar(50)
  status            String?   @db.NVarChar(50)
  created_at        DateTime?
  coordinate_source String?   @db.NVarChar(50)

  @@index([state])
}

model Categories {
  category_id   String    @id @db.NVarChar(50)
  category_name String?   @db.NVarChar(50)
  description   String?   @db.NVarChar(100)
  status        String?   @db.NVarChar(50)
  display_order Int?
  created_at    DateTime?
}

model Items_Catalog {
  item_id               String    @id @db.NVarChar(50)
  item_name             String?   @db.NVarChar(50)
  category_id           String?   @db.NVarChar(50)
  Unit                  String?   @db.NVarChar(50)
  measurement           String?   @db.NVarChar(50)
  whole_sale_Price      Decimal?  @db.Decimal(18, 2)
  Ave_Measurement_Price Decimal?  @db.Decimal(18, 2)
  Average_Unit_Price    Decimal?  @db.Decimal(18, 2)
  status                String?   @db.NVarChar(50)
  Max_whole_sale_Price  Decimal?  @db.Decimal(18, 2)
  min_price             Decimal?  @db.Decimal(18, 2)
  max_price             Decimal?  @db.Decimal(18, 2)
  created_at            DateTime?

  @@index([category_id])
}

model Brands {
  brand_id          String    @id @db.NVarChar(50)
  brand_name        String?   @db.NVarChar(50)
  category_id       String?   @db.NVarChar(50)
  category          String?   @db.NVarChar(50)
  country_of_origin String?   @db.NVarChar(50)
  description       String?   @db.NVarChar(50)
  status            String?   @db.NVarChar(50)
  created_at        DateTime?

  @@index([category_id])
}

model Subscription_Tiers {
  tier_id                  String   @id @db.NVarChar(50)
  tier_name                String?  @db.NVarChar(50)
  tier_rank                Int?
  price_ngn                Decimal? @db.Decimal(18, 2)
  billing_cycle            String?  @db.NVarChar(50)
  query_limit              Int?
  query_period             String?  @db.NVarChar(50)
  max_markets              Int?
  extra_market_fee_weekly  Decimal? @db.Decimal(18, 2)
  extra_market_fee_monthly Decimal? @db.Decimal(18, 2)
  priority_support         Boolean?
  api_access               Boolean?
  email_pdf                String?  @db.NVarChar(320)
  excel_download           Boolean?
  analytics_access         Boolean?
  dedicated_manager        Boolean?
  features                 String?  @db.NVarChar(50)
  description              String?  @db.NVarChar(50)
  status                   String?  @db.NVarChar(50)
}

model Price_History_NBS {
  id                 Int       @id @default(autoincrement())
  history_id         String?   @db.NVarChar(50)
  item_id            String?   @db.NVarChar(50)
  item_name_nbs      String?   @db.NVarChar(50)
  item_name_standard String?   @db.NVarChar(50)
  category_id        String?   @db.NVarChar(50)
  category_name      String?   @db.NVarChar(50)
  state_code_nbs     String?   @db.NVarChar(50)
  state_name_nbs     String?   @db.NVarChar(50)
  db_state           String?   @db.NVarChar(50)
  market_id          String?   @db.NVarChar(50)
  market_name        String?   @db.NVarChar(50)
  price_naira        Decimal?  @db.Decimal(18, 2)
  price_original     Decimal?  @db.Decimal(18, 2)
  variation_pct      Decimal?  @db.Decimal(6, 2)
  unit               String?   @db.NVarChar(50)
  year               Int?
  month              Int?
  observation_date   DateTime? @db.Date
  data_source        String?   @db.NVarChar(50)
  import_batch       String?   @db.NVarChar(50)
  created_at         DateTime?

  @@index([item_id])
  @@index([market_id])
  @@index([observation_date])
}

model Bank_Codes {
  bank_id   Int      @id @default(autoincrement())
  bank_name String?  @db.NVarChar(50)
  bank_code Int?
  bank_type String?  @db.NVarChar(50)
  is_active Boolean?
}

model Export_History {
  export_id    String    @id @db.VarChar(50)
  phone_number String?   @db.VarChar(20)
  consumer_id  String?   @db.VarChar(50)
  export_type  String?   @db.VarChar(30)
  format       String?   @db.VarChar(10)
  query_params String?   @db.NVarChar(Max)
  markets      String?   @db.NVarChar(Max)
  items        String?   @db.NVarChar(Max)
  date_range   String?   @db.VarChar(50)
  file_url     String?   @db.NVarChar(500)
  status       String?   @default("COMPLETED") @db.VarChar(20)
  row_count    Int?      @default(0)
  file_size_kb Int?      @default(0)
  created_at   DateTime? @default(now())

  @@index([phone_number])
}

model Blacklist {
  blacklist_id      String    @id @db.NVarChar(50)
  type              String?   @db.NVarChar(50)
  value             Int?
  reason            String?   @db.NVarChar(50)
  related_trader_id String?   @db.NVarChar(50)
  related_phone     String?   @db.NVarChar(20)
  evidence_url      String?   @db.NVarChar(2048)
  banned_at         DateTime?
  banned_by         String?   @db.NVarChar(50)
  expires_at        DateTime?
  status            String?   @db.NVarChar(50)
  notes             String?   @db.NVarChar(50)
}

// ============================================================================
// SESSION MODELS - Using session_id as primary key
// ============================================================================

model Consumer_Query_Sessions {
  session_id                   String    @id @db.NVarChar(50)
  Consumer_id                  String?   @db.NVarChar(50)
  phone_number                 String?   @db.NVarChar(20)
  session_status               String?   @db.NVarChar(50)
  current_step                 String?   @db.NVarChar(50)
  page_number                  Boolean?
  displayed_ids                String?   @db.NVarChar(255)
  preferred_language           String?   @db.NVarChar(50)
  session_data                 String?   @db.NVarChar(Max)
  lang_state                   String?   @db.NVarChar(255)
  selected_state               String?   @db.NVarChar(255)
  selected_state_id            String?   @db.NVarChar(50)
  selected_market              String?   @db.NVarChar(255)
  selected_market_id           String?   @db.NVarChar(50)
  selected_super_category      String?   @db.NVarChar(255)
  selected_super_category_name String?   @db.NVarChar(255)
  selected_category            String?   @db.NVarChar(255)
  selected_category_id         String?   @db.NVarChar(50)
  selected_item                String?   @db.NVarChar(255)
  selected_item_id             String?   @db.NVarChar(50)
  selected_item_unit           String?   @db.NVarChar(255)
  selected_item_min_price      Decimal?  @db.Decimal(18, 2)
  selected_item_max_price      Decimal?  @db.Decimal(18, 2)
  selected_item_wholesale      String?   @db.NVarChar(255)
  selected_brand               String?   @db.NVarChar(255)
  selected_brand_id            String?   @db.NVarChar(50)
  total_markets                String?   @db.NVarChar(255)
  timeout_prompted             String?   @db.NVarChar(255)
  timeout_prompt_at            DateTime?
  query_completed              String?   @db.NVarChar(255)
  created_at                   DateTime?
  expires_at                   DateTime?
  last_updated                 DateTime?
  selected_region              String?   @db.NVarChar(255)
  selected_region_code         String?   @db.NVarChar(255)

  @@index([phone_number])
}

model Consumer_Registration_Sessions {
  session_id         String    @id @db.NVarChar(50)
  phone_number       String?   @db.NVarChar(20)
  preferred_language String?   @db.NVarChar(50)
  current_step       String?   @db.NVarChar(50)
  session_status     String?   @db.NVarChar(50)
  first_name         String?   @db.NVarChar(50)
  last_name          String?   @db.NVarChar(50)
  gender             String?   @db.NVarChar(50)
  age_range          String?   @db.NVarChar(255)
  selected_tier      String?   @db.NVarChar(50)
  step_data          String?   @db.NVarChar(255)
  created_at         DateTime?
  expires_at         DateTime?
  last_updated       DateTime?
  timeout_prompted   String?   @db.NVarChar(255)
  timeout_prompt_at  DateTime?
  exit_count         Int?
  blocked_until      String?   @db.NVarChar(255)
  wa_profile_name    String?   @db.NVarChar(50)
  payment_ref        String?   @db.NVarChar(50)
  payment_provider   String?   @db.NVarChar(255)
  current_tier       String?   @db.NVarChar(50)

  @@index([phone_number])
}

// ============================================================================
// LOG MODELS - Using auto-increment ID
// ============================================================================

model Message_Log {
  id              Int       @id @default(autoincrement())
  timestamp       DateTime?
  phone_number    String?   @db.NVarChar(20)
  message_body    String?   @db.NVarChar(255)
  response_length String?   @db.NVarChar(255)
  status          String?   @db.NVarChar(255)

  @@index([phone_number])
}

model Error_Log {
  id            Int       @id @default(autoincrement())
  timestamp     DateTime?
  phone_number  String?   @db.NVarChar(20)
  message_body  String?   @db.NVarChar(255)
  status_code   String?   @db.NVarChar(255)
  error_details String?   @db.NVarChar(255)
  error_type    String?   @db.NVarChar(255)

  @@index([phone_number])
}
