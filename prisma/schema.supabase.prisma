generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-pg"
}

datasource db {
  provider = "postgresql"
  url      = env("SUPABASE_DB_URL")
}

model Consumers {
  consumer_id                String            @id()
  phone_number               String?
  preferred_language         String?
  first_name                 String?
  last_name                  String?
  full_name                  String?
  gender                     String?
  age_range                  String?
  registration_date          DateTime?
  registration_source        String?
  subscription_tier          String?
  subscription_start         String?
  subscription_end           String?
  grace_period_end           String?
  pending_downgrade_tier     String?
  downgrade_effective_date   DateTime?
  auto_renew                 String?
  daily_query_limit          Int?
  daily_queries_used         Boolean?
  weekly_queries_used        Boolean?
  weekly_queries_reset       String?
  queries_today              Boolean?
  queries_this_week          Boolean?
  total_queries              Int?
  last_query_date            DateTime?
  favorite_markets           String?
  favorite_items             String?
  max_markets                Int?
  favorite_markets_2         String?
  queries_remaining          Int?
  account_status             String?
  last_active_at             DateTime?
  created_at                 DateTime?
  updated_at                 DateTime?         @updatedAt
  referred_by                String?
  referral_code              String?
  daily_abandon_count        Int?
  last_abandon_date          DateTime?
  abandon_locked_until       String?
  registration_blocked_until String?
  notes                      String?
  date_of_birth              DateTime?
  age                        String?
  city                       String?
  state                      String?
  max_alerts                 Boolean?
  tc_accepted                Boolean?
  tc_accepted_at             DateTime?
  tc_version                 Boolean?
  phone_verified             Boolean?          @default(false)
  email_verified             Boolean?          @default(false)
  phone                      String?
  email                      String?
  password_hash              String?
  subscription_start_date    DateTime?
  subscription_end_date      DateTime?
  two_factor_enabled         Boolean           @default(false) @map("two_factor_enabled")
  two_factor_method          String?           @map("two_factor_method")
  two_factor_enabled_at      DateTime?         @map("two_factor_enabled_at")
  settings_json              String?
  Consumer_Addons            Consumer_Addons[]
  @@map("consumers")
}

model OTP_Codes {
  id          Int       @id() @default(autoincrement())
  identifier  String
  type        String
  code        String
  attempts    Int?      @default(0)
  verified    Boolean?  @default(false)
  verified_at DateTime?
  expires_at  DateTime
  created_at  DateTime? @default(now())

  @@index([expires_at])
  @@index([identifier, type])
  @@map("otp_codes")
}

model OTP_Sessions {
  otp_session_id Int      @id @default(autoincrement())
  phone_number   String
  otp_code       String
  verified       Boolean  @default(false)
  expires_at     DateTime
  created_at     DateTime @default(now())

  @@map("OTP_Sessions")
}

model Approved_Prices {
  price_id             String    @id()
  submission_id        String?
  state                String?
  market_name          String?
  market_id            String?
  category_name        String?
  category_id          String?
  item_name            String?
  item_id              String?
  brand_name           String?
  brand_id             String?
  price                Decimal?
  unit                 String?
  currency             String?   @default("NGN")
  submission_date      DateTime?
  validated_at         DateTime?
  validation_status    String?
  validators_count     Int?
  approval_count       Int?
  reject_count         Int?
  consensus_method     String?
