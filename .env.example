# ============================================================================
# NAIJAMARKET INTEL - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
# ============================================================================

# =================================
# DATABASE
# =================================
# Azure SQL Database connection string
# Format: sqlserver://username:password@server.database.windows.net:1433;database=DatabaseName;encrypt=true;trustServerCertificate=false
DATABASE_URL="sqlserver://your-username:your-password@naijafood.database.windows.net:1433;database=NaijaMarketIntel;encrypt=true;trustServerCertificate=false"

# =================================
# AUTHENTICATION
# =================================
# NextAuth.js configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-generate-with-openssl-rand-base64-32"

# Azure AD B2C (optional, for enterprise SSO)
# AZURE_AD_B2C_TENANT_NAME="your-tenant"
# AZURE_AD_B2C_CLIENT_ID="your-client-id"
# AZURE_AD_B2C_CLIENT_SECRET="your-client-secret"
# AZURE_AD_B2C_PRIMARY_USER_FLOW="B2C_1_signupsignin"

# =================================
# API KEYS
# =================================
# JWT signing secret
JWT_SECRET="your-jwt-secret-key-generate-with-openssl-rand-base64-64"

# API rate limiting
API_RATE_LIMIT_WINDOW_MS="60000"
API_RATE_LIMIT_MAX_REQUESTS="100"

# =================================
# EXTERNAL SERVICES
# =================================
# Twilio (for WhatsApp integration)
TWILIO_ACCOUNT_SID="your-twilio-account-sid-here"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_NUMBER="+14155238886"

# Paystack (for payments)
PAYSTACK_PUBLIC_KEY="pk_test_your-public-key"
PAYSTACK_SECRET_KEY="sk_test_your-secret-key"

# Flutterwave (alternative payment)
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-your-public-key"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-your-secret-key"

# =================================
# GOOGLE SHEETS (for data sync)
# =================================
GOOGLE_SHEETS_SPREADSHEET_ID="1n-7MXdoqvIoSHteBJaUYBmIPLjJBNtrE_jVuUxO5kr8"
# GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# =================================
# MONITORING & ANALYTICS
# =================================
# Azure Application Insights
# APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=your-key"

# Sentry (error tracking)
# SENTRY_DSN="https://your-key@sentry.io/project-id"

# =================================
# FEATURE FLAGS
# =================================
NEXT_PUBLIC_ENABLE_API_ACCESS="true"
NEXT_PUBLIC_ENABLE_REALTIME_PRICES="true"
NEXT_PUBLIC_ENABLE_PRICE_ALERTS="true"
NEXT_PUBLIC_ENABLE_EXPORT="true"

# =================================
# APPLICATION SETTINGS
# =================================
NEXT_PUBLIC_APP_NAME="NaijaMarket Intel"
NEXT_PUBLIC_APP_URL="https://naijamarket.intel"
NEXT_PUBLIC_SUPPORT_EMAIL="support@naijamarket.intel"

# Default timezone for price timestamps
NEXT_PUBLIC_DEFAULT_TIMEZONE="Africa/Lagos"

# Cache TTL in seconds
CACHE_TTL_PRICES="300"
CACHE_TTL_MARKETS="3600"
CACHE_TTL_ITEMS="3600"
