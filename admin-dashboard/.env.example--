# ============================================
# NAIJAMARKET INTEL ADMIN DASHBOARD
# Environment Variables Configuration
# ============================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production-32-chars-min

# Azure SQL Database
AZURE_SQL_SERVER=naijafood.database.windows.net
AZURE_SQL_DATABASE=NaijaMarketIntel
AZURE_SQL_USER=your-sql-username
AZURE_SQL_PASSWORD=your-sql-password

# Google Sheets API (Optional - for real-time sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
GOOGLE_SHEETS_ID=your-google-sheets-id

# VTPass API (Airtime Distribution)
VTPASS_API_KEY=your-vtpass-api-key
VTPASS_SECRET_KEY=your-vtpass-secret-key
VTPASS_BASE_URL=https://vtpass.com/api

# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Application Insights (Monitoring)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key;IngestionEndpoint=https://southafricanorth-1.in.applicationinsights.azure.com/

# Feature Flags
ENABLE_FRAUD_DETECTION=true
ENABLE_AUTO_PAYOUTS=true
ENABLE_REAL_TIME_SYNC=true

# Rate Limiting
MAX_SUBMISSIONS_PER_HOUR=2
MAX_SUBMISSIONS_PER_DAY=8

# Admin Configuration
ADMIN_EMAIL=olawale.sobogungod@giggabytes.eu
SUPPORT_EMAIL=support@naijamarket.ng
