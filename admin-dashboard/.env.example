# ============================================================================
# NAIJAMARKET INTEL - ADMIN DASHBOARD ENVIRONMENT VARIABLES
# ============================================================================
#
# Copy this file to .env.local and fill in the values.
#
# ============================================================================

# ============================================================================
# NEXTAUTH CONFIGURATION
# ============================================================================

# Secret for encrypting session tokens (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here-at-least-32-characters

# URL of your deployment (localhost for development, production URL for deployment)
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# GOOGLE SHEETS INTEGRATION
# ============================================================================

# Google Service Account credentials as a JSON string
# 1. Go to Google Cloud Console > IAM & Admin > Service Accounts
# 2. Create a service account or use existing one
# 3. Create a new JSON key for the service account
# 4. Copy the entire JSON content here (as a single line)
# 5. Share your Google Sheet with the service account email (editor access)
#
# Example: {"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"naijamarket-intel","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n","client_email":"naijamarket-sheets@naijamarket-intel.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"xxx"}

# Google Sheets Spreadsheet ID (from the URL)
# URL: https://docs.google.com/spreadsheets/d/1n-7MXdoqvIoSHteBJaUYBmIPLjJBNtrE_jVuUxO5kr8/edit
GOOGLE_SPREADSHEET_ID=1n-7MXdoqvIoSHteBJaUYBmIPLjJBNtrE_jVuUxO5kr8

# ============================================================================
# AZURE SQL DATABASE (Optional - for analytics sync)
# ============================================================================

# Azure SQL Server connection string
# Format: Server=tcp:naijafood.database.windows.net,1433;Initial Catalog=NaijaMarketIntel;Persist Security Info=False;User ID=your-username;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
AZURE_SQL_CONNECTION_STRING=Server=tcp:naijafood.database.windows.net,1433;Initial Catalog=NaijaMarketIntel;Persist Security Info=False;User ID=naijamarket_admin;Password=YOUR_PASSWORD_HERE;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# ============================================================================
# ADMIN USERS (Development Only)
# ============================================================================

# In production, use the Admin_Users sheet in Google Sheets
# For development, you can define hardcoded users here

# Demo admin credentials
DEMO_ADMIN_EMAIL=admin@naijamarket.ng
DEMO_ADMIN_PASSWORD=admin123
DEMO_ADMIN_NAME=Admin User
DEMO_ADMIN_ROLE=super_admin

# ============================================================================
# EXTERNAL API KEYS (Reference - managed in Settings page)
# ============================================================================

# These are stored in the platform settings and used by the WhatsApp bot
# Listed here for reference only - do NOT put actual keys in this file

# Twilio WhatsApp API (used by validators.txt)
# TWILIO_ACCOUNT_SID=ACxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# VTPass API (for airtime payouts)
# VTPASS_API_KEY=xxxxxx
# VTPASS_SECRET_KEY=xxxxxx

# Flutterwave API (for bank transfers)
# FLUTTERWAVE_PUBLIC_KEY=xxxxxx
# FLUTTERWAVE_SECRET_KEY=xxxxxx

# ============================================================================
# MONITORING (Optional)
# ============================================================================

# Application Insights (Azure)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx

# Sentry (Error tracking)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable mock data when Google Sheets is not configured
ENABLE_MOCK_DATA=true

# Enable debug logging
DEBUG_MODE=false

# Data refresh interval in milliseconds (default: 60000 = 1 minute)
DATA_REFRESH_INTERVAL=60000

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
